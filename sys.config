%% ErlBASIC System Configuration
%% This file configures runtime parameters for the application.
%%
%% Place this file in one of these locations:
%%   - Current directory: ./sys.config
%%   - Config directory: ./config/sys.config
%%   - Release directory: _build/default/rel/erlbasic/releases/0.1.0/sys.config
%%
%% Start with: erl -config sys.config -s erlbasic_app

[
  {erlbasic, [
    %% HTTP Configuration
    {http_port, 8081},
    
    %% HTTPS Configuration
    %% Set enable_https to true to start HTTPS listener
    {enable_https, true},
    {https_port, 8443},
    {certfile, "priv/ssl/cert.pem"},
    {keyfile, "priv/ssl/key.pem"},
    %% Optional: uncomment if using CA certificate
    %% {cacertfile, "priv/ssl/cacert.pem"},
    
    %% Security: maximum concurrent logged-in sessions per PPN (user account).
    %% Accounts in project 0 or 1 are exempt (unlimited). Default: 3.
    {max_sessions_per_ppn, 3},

    %% Optional machine-local override file (loaded at app startup).
    %% Useful for dev-box-specific settings without editing this file.
    %% {config_override_file, ".sys.override.config"},

    %% Storage backend: 'local' (default) or 's3'
    {storage_backend, local}

    %% Local backend root (overrides ~/ErlUsers/)
    %% {storage_local_root, "/data/erlbasic/users"},

    %% S3 backend (only used when storage_backend = s3)
    %% Connection details live in the private .s3.config file.
    %% {storage_s3_config_file, ".s3.config"},

    %% Homepage cache directory (always local; defaults to TMPDIR/TMP/TEMP)
    %% {homepage_cache_dir, "/var/cache/erlbasic"}
  ]},
  
  {kernel, [
    %% Logging configuration
    %% Set to 'error' to only show errors (suppresses SSL cert warnings)
    %% Set to 'warning' to show warnings and errors
    %% Levels: debug < info < notice < warning < error < critical < alert < emergency
    {logger_level, error},
    {logger, [
      {handler, default, logger_std_h,
        #{level => error,
          formatter => {logger_formatter, #{
            single_line => false,
            time_designator => $T
          }}
        }
      }
    ]}
  ]}
].

%% CONFIGURATION EXAMPLES:
%%
%% === Development Mode (HTTP only) ===
%% {erlbasic, [
%%   {http_port, 8081},
%%   {enable_https, false}
%% ]}
%%
%% === Development Mode (HTTPS with self-signed certs) ===
%% Generate certificates first: pwsh generate_certs.ps1
%% {erlbasic, [
%%   {http_port, 8081},
%%   {enable_https, true},
%%   {https_port, 8443},
%%   {certfile, "priv/ssl/cert.pem"},
%%   {keyfile, "priv/ssl/key.pem"}
%% ]}
%%
%% === Production Mode (HTTPS with Let's Encrypt) ===
%% {erlbasic, [
%%   {http_port, 80},
%%   {enable_https, true},
%%   {https_port, 443},
%%   {certfile, "/opt/erlbasic/priv/ssl/cert.pem"},
%%   {keyfile, "/opt/erlbasic/priv/ssl/key.pem"}
%% ]}
%%
%% === Behind Reverse Proxy (nginx/Apache) ===
%% Run on high ports, let proxy handle SSL
%% {erlbasic, [
%%   {http_port, 8081},
%%   {enable_https, false}
%% ]}
