%% Copy this file to .s3.config and fill in the real values.
%% This file is loaded at startup and should never be checked in.
[
  {storage_s3_endpoint, "http://localhost:4566"},
  {storage_s3_bucket, "erlbasic-private-bucket"},
  {storage_s3_prefix, "users/"},
  {storage_s3_region, "us-east-1"},
  {storage_s3_access_key_id, "test"},
  {storage_s3_secret_access_key, "test"}
].