10 REM sprites_hgr2.bas - HGR2 sprite control demo
20 REM Uses GETKEY to move player sprite and ON SPRITE GOSUB for collisions
30 HGR2
40 DIM PLAYER&(255),TARGET&(255)
50 FOR I=0 TO 255
60   PLAYER&(I)=255
70   TARGET&(I)=255
80 NEXT I
90 REM Build PLAYER: tiny saucer/UFO (green body, cyan dome, yellow lights)
100 FOR Y=0 TO 15
110   FOR X=0 TO 15
120     LET IDX=Y*16+X
130     IF Y>=8 AND Y<=11 AND X>=3 AND X<=12 THEN PLAYER&(IDX)=10
140     IF Y>=6 AND Y<=8 AND X>=6 AND X<=9 THEN PLAYER&(IDX)=11
150     IF Y=10 AND (X=5 OR X=7 OR X=9 OR X=11) THEN PLAYER&(IDX)=14
160     IF Y=12 AND (X=4 OR X=11) THEN PLAYER&(IDX)=8
170   NEXT X
180 NEXT Y
190 REM Build TARGET: small interceptor (red hull, yellow thruster)
200 FOR Y=0 TO 15
210   FOR X=0 TO 15
220     LET IDX=Y*16+X
230     IF Y>=4 AND Y<=11 AND X>=7 AND X<=8 THEN TARGET&(IDX)=12
240     IF Y=3 AND (X=7 OR X=8) THEN TARGET&(IDX)=12
250     IF Y=2 AND X=7 THEN TARGET&(IDX)=12
260     IF Y=9 AND (X=6 OR X=9) THEN TARGET&(IDX)=12
270     IF Y=10 AND (X=5 OR X=10) THEN TARGET&(IDX)=12
280     IF Y>=12 AND Y<=14 AND (X=7 OR X=8) THEN TARGET&(IDX)=14
290     IF Y=15 AND X=7 THEN TARGET&(IDX)=14
300   NEXT X
310 NEXT Y
320 SPRITE LOAD 1,16,16,PLAYER&(0)
330 SPRITE LOAD 2,16,16,TARGET&(0)
340 SPRITE SCALE 1,2
350 SPRITE SCALE 2,2
360 LET PX=120
370 LET PY=120
380 LET TX=500
390 LET TY=260
400 SPRITE 1,(PX,PY):SPRITE SHOW 1
410 SPRITE 2,(TX,TY):SPRITE SHOW 2
420 ON SPRITE GOSUB 900
430 PRINT "Use WASD to move, Q to quit"
440 PRINT "Target is the red enemy ship"
450 LET HIT%=0
460 GETKEY K$
470 IF K$="Q" OR K$="q" THEN GOTO 700
480 IF K$="W" OR K$="w" THEN PY=PY-8
490 IF K$="S" OR K$="s" THEN PY=PY+8
500 IF K$="A" OR K$="a" THEN PX=PX-8
510 IF K$="D" OR K$="d" THEN PX=PX+8
520 IF PX<0 THEN PX=0
530 IF PY<0 THEN PY=0
540 IF PX>768 THEN PX=768
550 IF PY>448 THEN PY=448
560 SPRITE 1,(PX,PY)
570 IF HIT%=0 THEN GOTO 460
580 PRINT "Collision detected!"
590 PRINT "Sprites ";SPRCOL1%;" and ";SPRCOL2%;" overlapped"
600 GOTO 700
700 TEXT
710 PRINT "Done."
720 END
900 LET HIT%=1
910 RETURN
