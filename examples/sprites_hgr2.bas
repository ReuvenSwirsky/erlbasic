10 REM sprites_hgr2.bas - 64x64 sprite control demo with 64-bit hex masks
20 REM Uses GETKEY to move player sprite and ON SPRITE GOSUB for collisions
30 HGR2
40 DIM BIT%(63),PLAYER%(63),TARGET%(63)
50 DIM PLAYERB&(4095),TARGETB&(4095)
60 LET BIT%(63)=1
70 FOR I%=62 TO 0 STEP -1
80   BIT%(I%)=BIT%(I%+1)*2
90 NEXT I%
100 FOR I%=0 TO 4095
110   PLAYERB&(I%)=255
120   TARGETB&(I%)=255
130 NEXT I%
140 REM 64x64 command saucer mask (16 hex digits = 64-bit unsigned row)
150 PLAYER%(12)=0x0000000000600000
160 PLAYER%(13)=0x0000000000F00000
170 PLAYER%(14)=0x0000000001F80000
180 PLAYER%(15)=0x0000000003FC0000
190 PLAYER%(16)=0x0000000007FE0000
200 PLAYER%(17)=0x000000001FFF8000
210 PLAYER%(18)=0x000000007FFFE000
220 PLAYER%(19)=0x00000000FFFFFF00
230 PLAYER%(20)=0x00000003FFFFFFC0
240 PLAYER%(21)=0x00000007FFFFFFE0
250 PLAYER%(22)=0x0000000FFC3FF3F0
260 PLAYER%(23)=0x0000001FF81FF81F
270 PLAYER%(24)=0x0000003FF00FF00F
280 PLAYER%(25)=0x0000007FE007E007
290 PLAYER%(26)=0x000000FFC003C003
300 PLAYER%(27)=0x000001FF80018001
310 PLAYER%(28)=0x000003FFFFFFFFC0
320 PLAYER%(29)=0x000001FFFFFFFF80
330 PLAYER%(30)=0x0000007FFC3FF000
340 PLAYER%(31)=0x0000001FE007F800
350 PLAYER%(32)=0x00000007C003E000
360 PLAYER%(33)=0x0000000180018000
370 REM 64x64 interceptor mask
380 TARGET%(8)=0x0000000000018000
390 TARGET%(9)=0x000000000003C000
400 TARGET%(10)=0x000000000007E000
410 TARGET%(11)=0x00000000000FF000
420 TARGET%(12)=0x00000000001FF800
430 TARGET%(13)=0x00000000003FFC00
440 TARGET%(14)=0x00000000007FFE00
450 TARGET%(15)=0x0000000000FFFF00
460 TARGET%(16)=0x0000000001FFFF80
470 TARGET%(17)=0x0000000003FFFFC0
480 TARGET%(18)=0x0000000007FFFFE0
490 TARGET%(19)=0x000000000FFFFFF0
500 TARGET%(20)=0x000000001FF81FF8
510 TARGET%(21)=0x000000007FE007FE
520 TARGET%(22)=0x00000001FFC003FF
530 TARGET%(23)=0x00000003FF8001FF
540 TARGET%(24)=0x00000007FF0000FF
550 TARGET%(25)=0x0000000FFE00007F
560 TARGET%(26)=0x0000001FFC00003F
570 TARGET%(27)=0x00000007F800001F
580 TARGET%(28)=0x00000001F000000F
590 TARGET%(29)=0x0000000070000007
600 TARGET%(30)=0x00000000038001C0
610 TARGET%(31)=0x0000000001C00380
620 TARGET%(32)=0x0000000000E00700
630 TARGET%(33)=0x0000000000700E00
640 TARGET%(34)=0x0000000000381C00
650 TARGET%(35)=0x00000000001FF800
660 FOR Y%=0 TO 63
670   LET WORK%=PLAYER%(Y%)
680   FOR X%=63 TO 0 STEP -1
690     LET IDX%=Y%*64+X%
700     IF WORK% MOD 2 = 1 THEN PLAYERB&(IDX%)=10
710     LET WORK%=INT(WORK%/2)
720   NEXT X%
730 NEXT Y%
740 FOR X%=26 TO 37
750   PLAYERB&(22*64+X%)=15
760 NEXT X%
770 FOR X%=18 TO 45 STEP 5
780   PLAYERB&(31*64+X%)=14
790 NEXT X%
800 PLAYERB&(33*64+14)=8
810 PLAYERB&(33*64+49)=8
820 FOR Y%=0 TO 63
830   LET WORK%=TARGET%(Y%)
840   FOR X%=63 TO 0 STEP -1
850     LET IDX%=Y%*64+X%
860     IF WORK% MOD 2 = 1 THEN TARGETB&(IDX%)=12
870     LET WORK%=INT(WORK%/2)
880   NEXT X%
890 NEXT Y%
900 FOR X%=28 TO 35
910   TARGETB&(16*64+X%)=15
920 NEXT X%
930 FOR Y%=28 TO 34
940   TARGETB&(Y%*64+31)=14
950   TARGETB&(Y%*64+32)=14
960 NEXT Y%
970 SPRITE LOAD 1,64,64,PLAYERB&(0)
980 SPRITE LOAD 2,64,64,TARGETB&(0)
990 LET PX=120
1000 LET PY=120
1010 LET TX=540
1020 LET TY=220
1030 SPRITE 1,(PX,PY):SPRITE SHOW 1
1040 SPRITE 2,(TX,TY):SPRITE SHOW 2
1050 ON SPRITE GOSUB 1400
1060 PRINT "Use WASD to move, Q to quit"
1070 PRINT "Target is the large red enemy ship"
1080 LET HIT%=0
1090 GETKEY K$
1100 IF K$="Q" OR K$="q" THEN GOTO 1300
1110 IF K$="W" OR K$="w" THEN PY=PY-8
1120 IF K$="S" OR K$="s" THEN PY=PY+8
1130 IF K$="A" OR K$="a" THEN PX=PX-8
1140 IF K$="D" OR K$="d" THEN PX=PX+8
1150 IF PX<0 THEN PX=0
1160 IF PY<0 THEN PY=0
1170 IF PX>736 THEN PX=736
1180 IF PY>336 THEN PY=336
1190 SPRITE 1,(PX,PY)
1200 IF HIT%=0 THEN GOTO 1090
1210 PRINT "Collision detected!"
1220 PRINT "Sprites ";SPRCOL1%;" and ";SPRCOL2%;" overlapped"
1230 GOTO 1300
1300 TEXT
1310 PRINT "Done."
1320 END
1400 LET HIT%=1
1410 RETURN
