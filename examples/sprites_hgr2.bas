10 REM sprites_hgr2.bas - 64x64 sprite control demo with 64-bit hex masks
20 REM Uses GETKEY to move player sprite and ON SPRITE GOSUB for collisions
30 HGR2
40 DIM BIT%(63),PLAYER%(63),TARGET%(63)
50 DIM PLAYERB&(4095),TARGETB&(4095)
60 LET BIT%(63)=1
70 FOR I%=62 TO 0 STEP -1
80   BIT%(I%)=BIT%(I%+1)*2
90 NEXT I%
100 FOR I%=0 TO 4095
110   PLAYERB&(I%)=255
120   TARGETB&(I%)=255
130 NEXT I%
140 REM 64x64 command saucer mask (16 hex digits = 64-bit unsigned row)
150 PLAYER%(12)=0x000000000FF00000
160 PLAYER%(13)=0x000000003FFC0000
170 PLAYER%(14)=0x000000007FFE0000
180 PLAYER%(15)=0x00000000FFFF0000
190 PLAYER%(16)=0x00000001FFFF8000
200 PLAYER%(17)=0x00000003FFFFC000
210 PLAYER%(18)=0x00000007FFFFE000
220 PLAYER%(19)=0x0000000FFFFFF000
230 PLAYER%(20)=0x0000001FFFFFF800
240 PLAYER%(21)=0x0000003FFFFFFC00
250 PLAYER%(22)=0x0000007FFFFFFE00
260 PLAYER%(23)=0x000000FFFFFFFF00
270 PLAYER%(24)=0x000001FFFFFFFF80
280 PLAYER%(25)=0x000003FFFFFFFFC0
290 PLAYER%(26)=0x00000FFFFFFFFFF0
300 PLAYER%(27)=0x00003FFFFFFFFFFC
310 PLAYER%(28)=0x0000FFFFFFFFFFFF
320 PLAYER%(29)=0x00003FFFFFFFFFFC
330 PLAYER%(30)=0x00000FFFFFFFFFF0
340 PLAYER%(31)=0x000003FC03FFFFC0
350 PLAYER%(32)=0x000000F0007FFE00
360 PLAYER%(33)=0x00000000000FF000
370 PLAYER%(34)=0x000000000003C000
380 REM 64x64 interceptor mask
390 TARGET%(8)=0x0000000000018000
400 TARGET%(9)=0x000000000003C000
410 TARGET%(10)=0x000000000007E000
420 TARGET%(11)=0x00000000000FF000
430 TARGET%(12)=0x00000000001FF800
440 TARGET%(13)=0x00000000003FFC00
450 TARGET%(14)=0x00000000007FFE00
460 TARGET%(15)=0x0000000000FFFF00
470 TARGET%(16)=0x0000000001FFFF80
480 TARGET%(17)=0x0000000003FFFFC0
490 TARGET%(18)=0x0000000007FFFFE0
500 TARGET%(19)=0x000000000FFFFFF0
510 TARGET%(20)=0x000000001FFFFFF8
520 TARGET%(21)=0x000000003FFFFFFC
530 TARGET%(22)=0x00000000FFFFFFFF
540 TARGET%(23)=0x00000001FFFFFFFF
550 TARGET%(24)=0x00000003FC3FC3FF
560 TARGET%(25)=0x0000000FF81F81FF
570 TARGET%(26)=0x0000001FF00F00FF
580 TARGET%(27)=0x00000007E00E007E
590 TARGET%(28)=0x00000000E003C003
600 TARGET%(29)=0x000000000003C000
610 TARGET%(30)=0x000000000007E000
620 TARGET%(31)=0x000000000003C000
630 FOR Y%=0 TO 63
640   LET ROW%=PLAYER%(Y%)
650   FOR X%=0 TO 63
660     LET IDX%=Y%*64+X%
670     IF ROW% AND BIT%(X%) THEN PLAYERB&(IDX%)=10
680   NEXT X%
690 NEXT Y%
700 FOR X%=26 TO 37
710   PLAYERB&(22*64+X%)=15
720 NEXT X%
730 FOR X%=18 TO 45 STEP 5
740   PLAYERB&(31*64+X%)=14
750 NEXT X%
760 PLAYERB&(33*64+14)=8
770 PLAYERB&(33*64+49)=8
780 FOR Y%=0 TO 63
790   LET ROW%=TARGET%(Y%)
800   FOR X%=0 TO 63
810     LET IDX%=Y%*64+X%
820     IF ROW% AND BIT%(X%) THEN TARGETB&(IDX%)=12
830   NEXT X%
840 NEXT Y%
850 FOR X%=28 TO 35
860   TARGETB&(16*64+X%)=15
870 NEXT X%
880 FOR Y%=28 TO 34
890   TARGETB&(Y%*64+31)=14
900   TARGETB&(Y%*64+32)=14
910 NEXT Y%
920 SPRITE LOAD 1,64,64,PLAYERB&(0)
930 SPRITE LOAD 2,64,64,TARGETB&(0)
940 LET PX=120
950 LET PY=120
960 LET TX=540
970 LET TY=220
980 SPRITE 1,(PX,PY):SPRITE SHOW 1
990 SPRITE 2,(TX,TY):SPRITE SHOW 2
1000 ON SPRITE GOSUB 1400
1010 PRINT "Use WASD to move, Q to quit"
1020 PRINT "Target is the large red enemy ship"
1030 LET HIT%=0
1040 GETKEY K$
1050 IF K$="Q" OR K$="q" THEN GOTO 1200
1060 IF K$="W" OR K$="w" THEN PY=PY-8
1070 IF K$="S" OR K$="s" THEN PY=PY+8
1080 IF K$="A" OR K$="a" THEN PX=PX-8
1090 IF K$="D" OR K$="d" THEN PX=PX+8
1100 IF PX<0 THEN PX=0
1110 IF PY<0 THEN PY=0
1120 IF PX>736 THEN PX=736
1130 IF PY>336 THEN PY=336
1140 SPRITE 1,(PX,PY)
1150 IF HIT%=0 THEN GOTO 1040
1160 PRINT "Collision detected!"
1170 PRINT "Sprites ";SPRCOL1%;" and ";SPRCOL2%;" overlapped"
1180 GOTO 1200
1200 TEXT
1210 PRINT "Done."
1220 END
1400 LET HIT%=1
1410 RETURN
