10 REM sprites.bas - 32x32 sprite demo using 32-bit hex row masks
20 REM Requires WebSocket graphics mode
30 HGR
40 DIM BIT%(31),UFO%(31),FIGHT%(31)
50 DIM UFOB&(1023),FIGHTB&(1023)
60 LET BIT%(31)=1
70 FOR I%=30 TO 0 STEP -1
80   BIT%(I%)=BIT%(I%+1)*2
90 NEXT I%
100 FOR I%=0 TO 1023
110   UFOB&(I%)=255
120   FIGHTB&(I%)=255
130 NEXT I%
140 REM 32x32 UFO body mask (0x........ = 32-bit unsigned row)
150 UFO%(6)=0x00018000
160 UFO%(7)=0x0003C000
170 UFO%(8)=0x0007E000
180 UFO%(9)=0x001FF800
190 UFO%(10)=0x007FFE00
200 UFO%(11)=0x00FFFF00
210 UFO%(12)=0x01FFFF80
220 UFO%(13)=0x03FFFFC0
230 UFO%(14)=0x07FFFFE0
240 UFO%(15)=0x0FF00FF0
250 UFO%(16)=0x1FFFFFF8
260 UFO%(17)=0x3FFFFFFC
270 UFO%(18)=0x7FF00FFE
280 UFO%(19)=0x3FC003FC
290 UFO%(20)=0x0F8001F0
300 UFO%(21)=0x030000C0
310 UFO%(22)=0x00C00030
320 REM 32x32 interceptor body mask
330 FIGHT%(4)=0x00018000
340 FIGHT%(5)=0x0003C000
350 FIGHT%(6)=0x0007E000
360 FIGHT%(7)=0x000FF000
370 FIGHT%(8)=0x001FF800
380 FIGHT%(9)=0x003FFC00
390 FIGHT%(10)=0x007FFE00
400 FIGHT%(11)=0x00FFFF00
410 FIGHT%(12)=0x01E7E780
420 FIGHT%(13)=0x03C3C3C0
430 FIGHT%(14)=0x078181E0
440 FIGHT%(15)=0x0F0000F0
450 FIGHT%(16)=0x1FF00FF8
460 FIGHT%(17)=0x3FFFFFFC
470 FIGHT%(18)=0x07FFFFE0
480 FIGHT%(19)=0x01CFF380
490 FIGHT%(20)=0x00C7E300
500 FIGHT%(21)=0x0003C000
510 FIGHT%(22)=0x0007E000
520 FIGHT%(23)=0x0003C000
530 FIGHT%(24)=0x00018000
540 REM Expand UFO mask into BYTE sprite pixels (bit-scan each row)
550 FOR Y%=0 TO 31
560   LET WORK%=UFO%(Y%)
570   FOR X%=31 TO 0 STEP -1
580     LET IDX%=Y%*32+X%
590     IF WORK% MOD 2 = 1 THEN UFOB&(IDX%)=11
600     LET WORK%=INT(WORK%/2)
610   NEXT X%
620 NEXT Y%
630 FOR X%=12 TO 19
640   UFOB&(14*32+X%)=9
650 NEXT X%
660 FOR X%=10 TO 22 STEP 3
670   UFOB&(21*32+X%)=14
680 NEXT X%
690 UFOB&(22*32+6)=8
700 UFOB&(22*32+25)=8
710 REM Expand interceptor mask into BYTE sprite pixels (bit-scan each row)
720 FOR Y%=0 TO 31
730   LET WORK%=FIGHT%(Y%)
740   FOR X%=31 TO 0 STEP -1
750     LET IDX%=Y%*32+X%
760     IF WORK% MOD 2 = 1 THEN FIGHTB&(IDX%)=12
770     LET WORK%=INT(WORK%/2)
780   NEXT X%
790 NEXT Y%
800 FOR X%=13 TO 18
810   FIGHTB&(10*32+X%)=15
820 NEXT X%
830 FOR Y%=21 TO 25
840   FIGHTB&(Y%*32+15)=14
850   FIGHTB&(Y%*32+16)=14
860 NEXT Y%
870 SPRITE LOAD 1,32,32,UFOB&(0)
880 SPRITE LOAD 2,32,32,FIGHTB&(0)
890 SPRITE 1,(60,160):SPRITE SHOW 1
900 SPRITE 2,(620,160):SPRITE SHOW 2
910 ON SPRITE GOSUB 1010
920 PRINT "32x32 enemy ship closing on UFO..."
930 FOR N%=0 TO 42
940   LET X2=620-N%*12
950   SPRITE 2,(X2,160)
960   SLEEP 0.05
970 NEXT N%
980 PRINT "Done."
990 END
1010 PRINT "COLLISION ";SPRCOL1%;" ";SPRCOL2%
1020 RETURN
