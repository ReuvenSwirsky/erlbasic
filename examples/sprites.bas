10 REM sprites.bas - Sprite loading, movement, and collision callback demo
20 REM Requires WebSocket graphics mode (HGR/HGR2)
30 HGR
40 DIM SHIP&(255),ENEMY&(255)
50 FOR I=0 TO 255
60   SHIP&(I)=255
70   ENEMY&(I)=255
80 NEXT I
90 REM Build SHIP: small saucer/UFO (cyan body, blue dome, yellow lights)
100 FOR Y=0 TO 15
110   FOR X=0 TO 15
120     LET IDX=Y*16+X
130     IF Y>=8 AND Y<=11 AND X>=3 AND X<=12 THEN SHIP&(IDX)=11
140     IF Y>=6 AND Y<=8 AND X>=6 AND X<=9 THEN SHIP&(IDX)=9
150     IF Y=10 AND (X=5 OR X=7 OR X=9 OR X=11) THEN SHIP&(IDX)=14
160     IF Y=12 AND (X=4 OR X=11) THEN SHIP&(IDX)=8
170   NEXT X
180 NEXT Y
190 REM Build ENEMY: tiny rocket/ship (red hull, yellow engine flame)
200 FOR Y=0 TO 15
210   FOR X=0 TO 15
220     LET IDX=Y*16+X
230     IF Y>=4 AND Y<=11 AND X>=7 AND X<=8 THEN ENEMY&(IDX)=12
240     IF Y=3 AND (X=7 OR X=8) THEN ENEMY&(IDX)=12
250     IF Y=2 AND X=7 THEN ENEMY&(IDX)=12
260     IF Y=10 AND (X=6 OR X=9) THEN ENEMY&(IDX)=12
270     IF Y=11 AND (X=5 OR X=10) THEN ENEMY&(IDX)=12
280     IF Y>=12 AND Y<=14 AND (X=7 OR X=8) THEN ENEMY&(IDX)=14
290     IF Y=15 AND X=7 THEN ENEMY&(IDX)=14
300   NEXT X
310 NEXT Y
320 SPRITE LOAD 1,16,16,SHIP&(0)
330 SPRITE LOAD 2,16,16,ENEMY&(0)
340 SPRITE SCALE 1,2
350 SPRITE SCALE 2,2
360 SPRITE 1,(60,180):SPRITE SHOW 1
370 SPRITE 2,(520,180):SPRITE SHOW 2
380 ON SPRITE GOSUB 900
390 PRINT "Moving enemy ship toward the UFO..."
400 FOR N%=0 TO 46
410   LET X2=520-N%*10
420   SPRITE 2,(X2,180)
430   SLEEP 0.05
440 NEXT N%
450 PRINT "Done."
460 END
900 PRINT "COLLISION ";SPRCOL1%;" ";SPRCOL2%
910 RETURN
