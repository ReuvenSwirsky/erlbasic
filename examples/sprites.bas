10 REM sprites.bas - 32x32 sprite demo using 32-bit hex row masks
20 REM Requires WebSocket graphics mode
30 HGR
40 DIM BIT%(31),UFO%(31),FIGHT%(31)
50 DIM UFOB&(1023),FIGHTB&(1023)
60 LET BIT%(31)=1
70 FOR I%=30 TO 0 STEP -1
80   BIT%(I%)=BIT%(I%+1)*2
90 NEXT I%
100 FOR I%=0 TO 1023
110   UFOB&(I%)=255
120   FIGHTB&(I%)=255
130 NEXT I%
140 REM 32x32 UFO body mask (0x........ = 32-bit unsigned row)
150 UFO%(6)=0x000FF000
160 UFO%(7)=0x003FFC00
170 UFO%(8)=0x007FFE00
180 UFO%(9)=0x00FFFF00
190 UFO%(10)=0x01FFFF80
200 UFO%(11)=0x03FFFFC0
210 UFO%(12)=0x07FFFFE0
220 UFO%(13)=0x0FFFFFF0
230 UFO%(14)=0x07FFFFE0
240 UFO%(15)=0x07C003E0
250 UFO%(16)=0x1FFFFFF8
260 UFO%(17)=0x3FFFFFFC
270 UFO%(18)=0x7FFFFFFE
280 UFO%(19)=0x3FFFFFFC
290 UFO%(20)=0x0FFFFFF0
300 UFO%(21)=0x03CFF3C0
310 UFO%(22)=0x00C000C0
320 REM 32x32 interceptor body mask
330 FIGHT%(4)=0x00018000
340 FIGHT%(5)=0x0003C000
350 FIGHT%(6)=0x0007E000
360 FIGHT%(7)=0x000FF000
370 FIGHT%(8)=0x001FF800
380 FIGHT%(9)=0x003FFC00
390 FIGHT%(10)=0x007FFE00
400 FIGHT%(11)=0x00FFFF00
410 FIGHT%(12)=0x00FFFF00
420 FIGHT%(13)=0x01FFFF80
430 FIGHT%(14)=0x03FFFFC0
440 FIGHT%(15)=0x07FFFFE0
450 FIGHT%(16)=0x0FFFFFF0
460 FIGHT%(17)=0x1FFFFFF8
470 FIGHT%(18)=0x0FCFF3F0
480 FIGHT%(19)=0x03CFF3C0
490 FIGHT%(20)=0x00CFF300
500 FIGHT%(21)=0x0007E000
510 FIGHT%(22)=0x0003C000
520 FIGHT%(23)=0x0007E000
530 FIGHT%(24)=0x0003C000
540 REM Expand UFO mask into BYTE sprite pixels
550 FOR Y%=0 TO 31
560   LET ROW%=UFO%(Y%)
570   FOR X%=0 TO 31
580     LET IDX%=Y%*32+X%
590     IF ROW% AND BIT%(X%) THEN UFOB&(IDX%)=11
600   NEXT X%
610 NEXT Y%
620 FOR X%=12 TO 19
630   UFOB&(14*32+X%)=9
640 NEXT X%
650 FOR X%=10 TO 22 STEP 3
660   UFOB&(21*32+X%)=14
670 NEXT X%
680 UFOB&(22*32+6)=8
690 UFOB&(22*32+25)=8
700 REM Expand interceptor mask into BYTE sprite pixels
710 FOR Y%=0 TO 31
720   LET ROW%=FIGHT%(Y%)
730   FOR X%=0 TO 31
740     LET IDX%=Y%*32+X%
750     IF ROW% AND BIT%(X%) THEN FIGHTB&(IDX%)=12
760   NEXT X%
770 NEXT Y%
780 FOR X%=13 TO 18
790   FIGHTB&(10*32+X%)=15
800 NEXT X%
810 FOR Y%=21 TO 25
820   FIGHTB&(Y%*32+15)=14
830   FIGHTB&(Y%*32+16)=14
840 NEXT Y%
850 SPRITE LOAD 1,32,32,UFOB&(0)
860 SPRITE LOAD 2,32,32,FIGHTB&(0)
870 SPRITE 1,(60,160):SPRITE SHOW 1
880 SPRITE 2,(620,160):SPRITE SHOW 2
890 ON SPRITE GOSUB 990
900 PRINT "32x32 enemy ship closing on UFO..."
910 FOR N%=0 TO 42
920   LET X2=620-N%*12
930   SPRITE 2,(X2,160)
940   SLEEP 0.05
950 NEXT N%
960 PRINT "Done."
970 END
990 PRINT "COLLISION ";SPRCOL1%;" ";SPRCOL2%
1000 RETURN
