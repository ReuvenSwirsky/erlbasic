10 REM SPACE_SPRITES.BAS
20 REM Sprite mini-game for ErlBASIC HGR2
30 REM 3 rows of 4x invaders sweep left/right and descend.
40 REM Player launcher moves independently at bottom and fires upward missiles.
50 HGR2
60 COLOR 11
70 LOCATE 22,1:PRINT "SPACE INVADERS - SPRITE FLEET (HGR2)"
80 COLOR 7
90 LOCATE 23,1:PRINT "A/D = MOVE   SPACE/F = FIRE   Q = QUIT"
100 LOCATE 24,1:PRINT "Timer-driven fleet movement. Each invader needs 3 hits."
110 LOCATE 25,1:PRINT "SCORE: 0   LEFT: 18   LIVES: 3   LEVEL: 1"
120 REM Sprite data
130 DIM P&(63),E0&(63),E1&(63),E2&(63),B&(63),EB&(63)
140 FOR I=0 TO 63
150   P&(I)=255
160   E0&(I)=255
170   E1&(I)=255
180   E2&(I)=255
190   B&(I)=255
195   EB&(I)=255
200 NEXT I
210 REM Player launcher 8x8
220 FOR X=2 TO 5
230   P&(4*8+X)=10
240 NEXT X
250 FOR X=1 TO 6
260   P&(5*8+X)=10
270 NEXT X
280 P&(6*8+3)=15:P&(6*8+4)=15
290 P&(7*8+2)=15:P&(7*8+5)=15
300 REM Invader state 0 (healthy)
310 FOR X=1 TO 6
320   E0&(1*8+X)=12
330   E0&(2*8+X)=12
340 NEXT X
350 E0&(3*8+2)=12:E0&(3*8+5)=12
360 FOR X=2 TO 5
370   E0&(4*8+X)=14
380 NEXT X
390 E0&(5*8+1)=12:E0&(5*8+6)=12
400 REM Invader state 1 (damaged)
410 FOR X=1 TO 6
420   E1&(1*8+X)=12
430 NEXT X
440 E1&(2*8+2)=12:E1&(2*8+3)=8:E1&(2*8+4)=12:E1&(2*8+5)=12
450 E1&(3*8+2)=12:E1&(3*8+5)=12
460 E1&(4*8+2)=14:E1&(4*8+4)=14
470 E1&(5*8+1)=12:E1&(5*8+6)=12
480 REM Invader state 2 (heavy damage)
490 E2&(1*8+2)=12:E2&(1*8+5)=12
500 E2&(2*8+3)=8:E2&(2*8+4)=8
510 E2&(3*8+2)=12:E2&(3*8+5)=12
520 E2&(4*8+3)=14:E2&(4*8+4)=14
530 E2&(5*8+2)=12:E2&(5*8+5)=12
540 REM Missile 8x8 (narrow bolt)
550 B&(0*8+3)=15
560 B&(1*8+3)=10
570 B&(2*8+3)=10
580 B&(3*8+3)=10
590 B&(4*8+3)=10
595 REM Enemy bullet 8x8 (red/orange)
596 EB&(1*8+3)=12
597 EB&(2*8+3)=14
598 EB&(3*8+3)=12
599 EB&(4*8+3)=14
600 EB&(5*8+3)=12
605 SPRITE CLEAR
610 SPRITE LOAD 1,8,8,P&(0)
620 SPRITE LOAD 2,8,8,B&(0)
625 SPRITE LOAD 3,8,8,EB&(0)
630 SPRITE SCALE 1,4
640 SPRITE SCALE 2,3
645 SPRITE SCALE 3,2
650 DIM INVID%(17),INVX%(17),INVY%(17),INVHP%(17),INVALIVE%(17)
660 LET IDX%=0
670 FOR R%=0 TO 2
680   FOR C%=0 TO 5
690     LET ID%=10+IDX%
700     INVID%(IDX%)=ID%
710     INVX%(IDX%)=80+C%*120
720     INVY%(IDX%)=40+R%*80
730     INVHP%(IDX%)=3
740     INVALIVE%(IDX%)=1
750     SPRITE LOAD ID%,8,8,E0&(0)
760     SPRITE SCALE ID%,4
770     SPRITE ID%,(INVX%(IDX%),INVY%(IDX%)):SPRITE SHOW ID%
780     IDX%=IDX%+1
790   NEXT C%
800 NEXT R%
810 LET PX=392
820 LET PY=430
830 LET BX=-30
840 LET BY=-30
850 LET BACTIVE%=0
855 LET EXB=-30
856 LET EYB=-30
857 LET EBACTIVE%=0
860 LET ALIVELEFT%=18
870 LET SCORE%=0
880 LET LEVEL%=1
885 LET LIVES%=3
890 LET GAMEOVER%=0
900 LET WIN%=0
910 LET DIR%=1
920 LET INVSTEP%=8
930 LET TICK%=0
940 ON SPRITE GOSUB 3000
942 ON TIMER(0.16) GOSUB 2600
950 SPRITE 1,(PX,PY):SPRITE SHOW 1
960 SPRITE 2,(BX,BY):SPRITE HIDE 2
965 SPRITE 3,(EXB,EYB):SPRITE HIDE 3
970 GET K$
980 IF K$="Q" OR K$="q" THEN GOTO 4000
990 IF K$="A" OR K$="a" THEN PX=PX-14
1000 IF K$="D" OR K$="d" THEN PX=PX+14
1010 IF PX<0 THEN PX=0
1020 IF PX>768 THEN PX=768
1030 IF (K$=" " OR K$="F" OR K$="f") AND BACTIVE%=0 THEN BX=PX:BY=PY-36:BACTIVE%=1:SPRITE 2,(BX,BY):SPRITE SHOW 2:SOUND 1,230,10,6
1040 SPRITE 1,(PX,PY)
1050 TICK%=TICK%+1
1055 LET BEATWAIT%=12-LEVEL%
1056 IF BEATWAIT%<4 THEN BEATWAIT%=4
1060 IF TICK% MOD BEATWAIT%=0 THEN SOUND 0,150+(TICK% MOD 28),8,4
1220 IF BACTIVE%=0 THEN GOTO 1250
1230 BY=BY-24
1240 SPRITE 2,(BX,BY)
1250 IF BACTIVE%=1 AND BY<-40 THEN BACTIVE%=0:SPRITE HIDE 2
1252 IF EBACTIVE%=1 THEN EYB=EYB+12+LEVEL%
1253 IF EBACTIVE%=1 THEN SPRITE 3,(EXB,EYB)
1254 IF EBACTIVE%=1 AND EYB>470 THEN EBACTIVE%=0:SPRITE HIDE 3
1260 LOCATE 25,1
1270 PRINT "SCORE: ";SCORE%;"   LEFT: ";ALIVELEFT%;"   LIVES: ";LIVES%;"   LEVEL: ";LEVEL%;"     ";
1280 IF GAMEOVER%=1 THEN GOTO 4000
1285 IF LIVES%<=0 THEN GAMEOVER%=1
1290 SLEEP 0.03
1300 GOTO 970
2000 REM Fleet descends on each side bounce
2010 SOUND 0,110,8,8
2020 FOR DI%=0 TO 17
2030   IF INVALIVE%(DI%)=0 THEN GOTO 2070
2040   INVY%(DI%)=INVY%(DI%)+16
2050   SPRITE INVID%(DI%),(INVX%(DI%),INVY%(DI%))
2060   IF INVY%(DI%)>=380 THEN GAMEOVER%=1
2070 NEXT DI%
2080 RETURN
2300 REM Spawn enemy bullet from an alive invader
2310 LET START%=TICK% MOD 18
2320 FOR SJ%=0 TO 17
2330   LET SI%=START%+SJ%
2340   IF SI%>17 THEN SI%=SI%-18
2350   IF INVALIVE%(SI%)=0 THEN GOTO 2380
2360   EXB=INVX%(SI%)+14
2370   EYB=INVY%(SI%)+26
2372   EBACTIVE%=1
2374   SPRITE 3,(EXB,EYB):SPRITE SHOW 3
2376   SOUND 0,150,6,5
2378   RETURN
2380 NEXT SJ%
2390 RETURN
2600 REM Timer handler: move fleet and trigger enemy fire asynchronously
2610 LET LEFT%=9999
2620 LET RIGHT%=-1
2630 FOR TI%=0 TO 17
2640   IF INVALIVE%(TI%)=0 THEN GOTO 2670
2650   IF INVX%(TI%)<LEFT% THEN LEFT%=INVX%(TI%)
2660   IF INVX%(TI%)>RIGHT% THEN RIGHT%=INVX%(TI%)
2670 NEXT TI%
2680 IF DIR%=1 AND RIGHT%+INVSTEP%>768 THEN DIR%=-1:GOSUB 2000
2690 IF DIR%=-1 AND LEFT%-INVSTEP%<0 THEN DIR%=1:GOSUB 2000
2700 FOR TI%=0 TO 17
2710   IF INVALIVE%(TI%)=0 THEN GOTO 2740
2720   INVX%(TI%)=INVX%(TI%)+DIR%*INVSTEP%
2730   SPRITE INVID%(TI%),(INVX%(TI%),INVY%(TI%))
2740 NEXT TI%
2750 LET FIREWAIT%=26-LEVEL%*2
2760 IF FIREWAIT%<8 THEN FIREWAIT%=8
2770 IF EBACTIVE%=0 AND TICK% MOD FIREWAIT%=0 THEN GOSUB 2300
2780 RETURN
3000 REM Collision handler: missile (2) vs invaders (10-27)
3002 IF (SPRCOL1%=1 AND SPRCOL2%=3) OR (SPRCOL1%=3 AND SPRCOL2%=1) THEN EBACTIVE%=0:SPRITE HIDE 3:LIVES%=LIVES%-1:SOUND 1,130,9,12
3004 IF LIVES%<=0 THEN GAMEOVER%=1
3010 LET HITID%=0
3020 IF SPRCOL1%=2 AND SPRCOL2%>=10 THEN HITID%=SPRCOL2%
3030 IF SPRCOL2%=2 AND SPRCOL1%>=10 THEN HITID%=SPRCOL1%
3040 IF HITID%=0 THEN RETURN
3050 BACTIVE%=0
3060 SPRITE HIDE 2
3070 FOR CI%=0 TO 17
3080   IF INVID%(CI%)<>HITID% THEN GOTO 3180
3090   IF INVALIVE%(CI%)=0 THEN GOTO 3180
3100   INVHP%(CI%)=INVHP%(CI%)-1
3110   IF INVHP%(CI%)=2 THEN SPRITE LOAD HITID%,8,8,E1&(0):SPRITE SCALE HITID%,4:SPRITE HITID%,(INVX%(CI%),INVY%(CI%)):SPRITE SHOW HITID%:SOUND 1,190,9,9
3120   IF INVHP%(CI%)=1 THEN SPRITE LOAD HITID%,8,8,E2&(0):SPRITE SCALE HITID%,4:SPRITE HITID%,(INVX%(CI%),INVY%(CI%)):SPRITE SHOW HITID%:SOUND 1,170,7,10
3130   IF INVHP%(CI%)>0 THEN GOTO 3180
3140   INVALIVE%(CI%)=0
3150   ALIVELEFT%=ALIVELEFT%-1
3160   SCORE%=SCORE%+25
3170   LEVEL%=1+INT(SCORE%/150):INVSTEP%=6+LEVEL%:SPRITE HIDE HITID%:SOUND 1,255,10,12
3180 NEXT CI%
3190 IF ALIVELEFT%=0 THEN WIN%=1:GAMEOVER%=1
3200 RETURN
4000 LOCATE 24,1
4010 IF WIN%=1 THEN COLOR 10:PRINT "YOU WIN! Fleet destroyed.                              ";
4020 IF WIN%=0 AND GAMEOVER%=1 THEN COLOR 12:PRINT "GAME OVER - Fleet broke through your defense.           ";
4030 IF WIN%=0 AND GAMEOVER%=0 THEN COLOR 14:PRINT "QUIT.                                                  ";
4040 COLOR 7
4050 LOCATE 25,1:PRINT "Final score: ";SCORE%;"   Press any key...               ";
4060 SLEEP
4070 TEXT
4080 PRINT "SPACE INVADERS SPRITE FLEET COMPLETE"
4090 END
