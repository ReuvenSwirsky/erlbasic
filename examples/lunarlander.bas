10 REM LUNAR LANDER FOR ERLBASIC (SIDE-VIEW LEM)
20 REM Controls: A=left thrust, D=right thrust, W=main engine, Q=quit
30 REM Land on the pad with low horizontal and vertical speed
40 REM
50 HGR2
60 BUFFER ON
70 COLOR 11
80 LOCATE 22,1
90 PRINT "LUNAR LANDER  A/D=SIDE THRUST  W=MAIN ENGINE  Q=QUIT"
100 COLOR 7
110 REM
120 LET GRAV = 0.035
130 LET MAINTHR = 0.090
140 LET SIDETHR = 0.020
150 LET DRAG = 0.997
160 LET SAFEVX = 0.85
170 LET SAFEVY = 1.10
180 LET SHIPFOOT = 18
190 LET LEGSPAN = 12
200 LET FUEL = 950
210 LET X = 400
220 LET Y = 70
230 LET VX = 0
240 LET VY = 0
250 LET FRAME = 0
260 LET LAND = 0
270 LET CRASH = 0
280 REM
290 DIM T(800)
300 DIM SX(40)
310 DIM SY(40)
320 LET PADL = 385
330 LET PADR = 415
340 GOSUB 2000
350 GOSUB 2300
360 REM
370 REM Main game loop
380 LET FLAME = 0
390 FOR KS = 1 TO 4
400   GET K$
410   IF K$ <> "" THEN GOSUB 3400
420 NEXT KS
480 REM
490 LET VX = VX * DRAG
500 LET VY = VY + GRAV
510 LET X = X + VX
520 LET Y = Y + VY
530 IF X < 16 THEN X = 16: VX = 0
540 IF X > 783 THEN X = 783: VX = 0
550 LET XI = INT(X)
560 LET LX = XI - LEGSPAN
570 LET RX = XI + LEGSPAN
580 LET LGY = T(LX)
590 LET RGY = T(RX)
600 LET GY = LGY
610 IF RGY > GY THEN GY = RGY
620 IF Y + SHIPFOOT >= GY THEN GOSUB 4000
630 GOSUB 2600
640 IF LAND = 1 THEN GOTO 5200
650 IF CRASH = 1 THEN GOTO 5300
660 SLEEP 0.03
670 GOTO 380
680 REM
3400 REM Decode one key and dispatch action (ON...GOSUB)
3410 LET ACT = 0
3420 IF K$ = "a" THEN ACT = 1
3430 IF K$ = "A" THEN ACT = 1
3440 IF K$ = "d" THEN ACT = 2
3450 IF K$ = "D" THEN ACT = 2
3460 IF K$ = "w" THEN ACT = 3
3470 IF K$ = "W" THEN ACT = 3
3480 IF K$ = "q" THEN ACT = 4
3490 IF K$ = "Q" THEN ACT = 4
3500 IF ACT = 0 THEN RETURN
3510 ON ACT GOSUB 3000, 3100, 3200, 5000
3520 RETURN
3530 REM
2000 REM Build terrain with a flat landing pad
2010 FOR I = 0 TO 799
2020   LET H = 395 + 30 * SIN(I / 45) + 18 * SIN(I / 19)
2030   IF H < 305 THEN H = 305
2040   IF H > 455 THEN H = 455
2050   IF I >= PADL THEN IF I <= PADR THEN H = 420
2060   T(I) = H
2070 NEXT I
2080 RETURN
2090 REM
2300 REM Random star field
2310 FOR I = 1 TO 40
2320   SX(I) = INT(RND(1) * 800)
2330   SY(I) = INT(RND(1) * 440)
2340 NEXT I
2350 RETURN
2360 REM
2600 REM Draw frame and HUD
2610 RECT (0,0)-(799,479),0
2620 FOR I = 1 TO 40
2630   PSET (SX(I), SY(I)), 15
2640 NEXT I
2650 FOR I = 0 TO 798
2660   LINE (I, T(I))-(I+1, T(I+1)), 10
2670 NEXT I
2680 LINE (PADL, T(PADL))-(PADR, T(PADR)), 14
2690 LET SXI = INT(X)
2700 LET SYI = INT(Y)
2710 REM Side-view LEM body (more detailed ascent + descent stages)
2720 RECT (SXI-6, SYI+4)-(SXI+8, SYI+13), 8
2730 RECT (SXI-2, SYI)-(SXI+4, SYI+4), 15
2740 LINE (SXI-6, SYI+4)-(SXI+8, SYI+4), 7
2750 LINE (SXI-6, SYI+13)-(SXI+8, SYI+13), 7
2760 LINE (SXI+4, SYI+1)-(SXI+8, SYI+4), 15
2770 PSET (SXI+1, SYI+2), 11
2780 PSET (SXI+2, SYI+2), 11
2790 REM Antenna and docking probe
2800 LINE (SXI+4, SYI+1)-(SXI+7, SYI-2), 15
2810 PSET (SXI+8, SYI-2), 15
2820 REM Engine bell / undercarriage detail
2830 LINE (SXI-1, SYI+13)-(SXI+3, SYI+13), 7
2840 LINE (SXI, SYI+13)-(SXI-1, SYI+16), 8
2850 LINE (SXI+2, SYI+13)-(SXI+3, SYI+16), 8
2860 REM Legs, braces, and footpads
2870 LINE (SXI-5, SYI+13)-(SXI-12, SYI+18), 15
2880 LINE (SXI+7, SYI+13)-(SXI+14, SYI+18), 15
2890 LINE (SXI-4, SYI+12)-(SXI-10, SYI+16), 7
2900 LINE (SXI+6, SYI+12)-(SXI+12, SYI+16), 7
2910 LINE (SXI-15, SYI+18)-(SXI-9, SYI+18), 15
2920 LINE (SXI+11, SYI+18)-(SXI+17, SYI+18), 15
2930 PSET (SXI-12, SYI+18), 10
2940 PSET (SXI+14, SYI+18), 10
2950 REM Thruster flames (larger plumes)
2960 IF FLAME = 1 THEN LINE (SXI+1, SYI+13)-(SXI+1, SYI+24), 12
2970 IF FLAME = 1 THEN LINE (SXI, SYI+15)-(SXI+2, SYI+24), 14
2980 IF FLAME = 2 THEN LINE (SXI-7, SYI+9)-(SXI-16, SYI+9), 9
2990 IF FLAME = 2 THEN LINE (SXI-8, SYI+8)-(SXI-16, SYI+10), 11
2995 IF FLAME = 3 THEN LINE (SXI+9, SYI+9)-(SXI+18, SYI+9), 9
2996 IF FLAME = 3 THEN LINE (SXI+10, SYI+8)-(SXI+18, SYI+10), 11
3270 LOCATE 23,1
3280 COLOR 11
3290 PRINT "FUEL:"; INT(FUEL); "  ALT:"; INT(GY-Y-SHIPFOOT); "  VX:"; INT(VX*100)/100; "  VY:"; INT(VY*100)/100; "      ";
3300 COLOR 7
3310 LOCATE 24,1
3320 PRINT "SAFE LANDING: |VX| <= "; SAFEVX; "  |VY| <= "; SAFEVY; "                     ";
3330 LOCATE 25,1
3340 PRINT "PAD X:"; PADL; "-"; PADR; "   FRAME:"; FRAME; "                        ";
3350 LET FRAME = FRAME + 1
3360 FLUSH
3370 RETURN
3380 REM
3000 REM Left thrust
3010 IF FUEL <= 0 THEN RETURN
3020 LET VX = VX - SIDETHR
3030 LET FUEL = FUEL - 1
3040 LET FLAME = 2
3050 RETURN
3060 REM
3100 REM Right thrust
3110 IF FUEL <= 0 THEN RETURN
3120 LET VX = VX + SIDETHR
3130 LET FUEL = FUEL - 1
3140 LET FLAME = 3
3150 RETURN
3160 REM
3200 REM Main engine
3210 IF FUEL <= 0 THEN RETURN
3220 LET VY = VY - MAINTHR
3230 LET FUEL = FUEL - 2
3240 LET FLAME = 1
3250 RETURN
3260 REM
4000 REM Touchdown logic based on landing feet
4010 LET Y = GY - SHIPFOOT
4020 LET ONSAFE = 0
4030 IF LX >= PADL THEN IF RX <= PADR THEN ONSAFE = 1
4040 IF ONSAFE = 1 THEN IF ABS(VX) <= SAFEVX THEN IF ABS(VY) <= SAFEVY THEN LAND = 1: RETURN
4050 CRASH = 1
4060 RETURN
4070 REM
5000 REM Player quit
5010 BUFFER OFF
5020 TEXT
5030 PRINT "LUNAR LANDER aborted."
5040 END
5050 REM
5200 REM Successful landing
5210 LOCATE 24,1
5220 COLOR 10
5230 PRINT "SOFT LANDING! SCORE:"; INT(FUEL*10); "                               ";
5240 COLOR 7
5250 LOCATE 25,1
5260 PRINT "Press any key to return to text mode...";
5270 FLUSH
5280 GETKEY A$
5290 BUFFER OFF
5295 TEXT
5296 PRINT "SOFT LANDING! FINAL SCORE:"; INT(FUEL*10)
5297 END
5300 REM
5310 REM Crash landing
5320 LOCATE 24,1
5330 COLOR 12
5340 PRINT "CRASH! IMPACT VX:"; INT(ABS(VX)*100)/100; " VY:"; INT(ABS(VY)*100)/100; "               ";
5350 COLOR 7
5360 LOCATE 25,1
5370 PRINT "Press any key to return to text mode...";
5380 FLUSH
5390 GETKEY A$
5400 LOCATE 24,1
5410 COLOR 12
5420 PRINT "YOU CRASHED. TRY AGAIN.";
5430 COLOR 7
5440 FLUSH
5450 BUFFER OFF
5460 TEXT
5470 END
