{application, erlbasic,
 [{description, "Erlang BASIC interpreter over TCP and WebSocket"},
  {vsn, "0.1.0"},
  {modules, [erlbasic_app, erlbasic_sup, erlbasic_listener, erlbasic_web_listener, erlbasic_conn, erlbasic_conn_sup, erlbasic_interp,
             erlbasic_interpreter, erlbasic_basic, erlbasic_interpreter_selector,
             erlbasic_default_interpreter_selector, erlbasic_shell, erlbasic_session,
             erlbasic_tcp_conn, erlbasic_ws_conn, erlbasic_ws_handler, erlbasic_http_handler, erlbasic_homepage_handler,
             erlbasic_accounts, erlbasic_limits, erlbasic_admin_handler, erlbasic_storage,
             erlbasic_storage_backend, erlbasic_storage_local, erlbasic_storage_s3,
             erlbasic_s3_config, erlbasic_config_override]},
  {registered, []},
  {applications, [kernel, stdlib, crypto, cowboy, erlcloud]},
  {mod, {erlbasic_app, []}},
  {env, [
    {port, 5555},
    {web_port, 8081},
    {config_override_file, ".sys.override.config"},
    {storage_backend, local},
    {storage_s3_config_file, ".s3.config"},
    {default_storage_limit_blocks, 256},
    {default_memory_limit_kb, 512}
  ]}
 ]}.